# Copy to .env (or set these in your hosting dashboard)
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: a separate random secret for signing the admin session cookie
SESSION_SECRET=
# Full public address of the site, used for SEO links (no trailing slash)
SITE_URL=https://www.example.co.il
PORT=3000
# Where vehicles/leads and uploaded photos are stored (must be persistent disk)
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Sync the inventory from Liran's machine.co.il ads every N hours (0 = off)
MACHINE_SYNC_HOURS=1
MACHINE_USER_ID=18783
# Email notification for every new lead (any SMTP provider; Gmail needs an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
# Optional sender address; defaults to SMTP_USER
LEAD_EMAIL_FROM=

# Copy to .env (or set these in your hosting dashboard)
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: a separate random secret for signing the admin session cookie
SESSION_SECRET=
# Full public address of the site, used for SEO links (no trailing slash)
SITE_URL=https://www.example.co.il
PORT=3000
# Where vehicles/leads and uploaded photos are stored (must be persistent disk)
DATA_DIR=./data
UPLOAD_DIR=./uploads
